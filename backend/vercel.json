{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "functions": {
    "api/index.js": { "includeFiles": "{dist/**,prisma/**,node_modules/.prisma/**,node_modules/@prisma/client/**}", "maxDuration": 30 }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "crons": [{ "path": "/cron/tick", "schedule": "0 6 * * *" }]
}

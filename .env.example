# Pooled connection (runtime queries) — Neon "-pooler" host + pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&pgbouncer=true&connect_timeout=15"
# Direct connection (migrations) — same host WITHOUT "-pooler"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require&connect_timeout=15"

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=5050
HOST=0.0.0.0
CORS_ORIGINS=*

# Optional: base64 of Firebase service-account JSON (enables FCM push)
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Public URL of the deployed web app (used in invitation emails)
APP_URL=http://localhost:8080
# Transactional email via https://resend.com (without a key, emails are only logged)
RESEND_API_KEY=
EMAIL_FROM="BabyDaily <onboarding@resend.dev>"
# Secret for the /cron/tick endpoint (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
